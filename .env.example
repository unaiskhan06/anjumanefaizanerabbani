# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# --- Core ---
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# ALLOWED_HOSTS=anjumanefaizanerabbani.com,www.anjumanefaizanerabbani.com
# CSRF_TRUSTED_ORIGINS=https://anjumanefaizanerabbani.com,https://www.anjumanefaizanerabbani.com
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=Asia/Kolkata

# --- Database ---
# Leave empty to use SQLite locally. Production (PostgreSQL):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- YouTube (used by: python manage.py import_channel) ---
# Several channels: separate with commas (main channel, Ahmed Raza Rabbani)
YOUTUBE_CHANNEL_ID=UCXCmmzfyuAPh9OAzAVbIrVg,UCWRR-TOgsbtwb2Dq4rCItNA

# --- Email (contact form notifications) ---
# For Gmail, create an "App password" (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=anjumanefaizanerabbani@gmail.com

# --- Media on Cloudinary (optional, production) ---
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Security (production; defaults are safe) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
